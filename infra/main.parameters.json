{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL=}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "searchSku": {
      "value": "${SEARCH_SKU=basic}"
    },
    "openAiCapacity": {
      "value": "${OPENAI_CAPACITY=1}"
    },
    "contentSafetySku": {
      "value": "${CONTENT_SAFETY_SKU=S0}"
    },
    "containerAppMinReplicas": {
      "value": "${CONTAINER_APP_MIN_REPLICAS=0}"
    },
    "langfusePublicKey": {
      "value": "${LANGFUSE_PUBLIC_KEY=}"
    },
    "langfuseSecretKey": {
      "value": "${LANGFUSE_SECRET_KEY=}"
    },
    "langfuseHost": {
      "value": "${LANGFUSE_HOST=https://cloud.langfuse.com}"
    }
  }
}
